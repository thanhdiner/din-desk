<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DinDesk</AssemblyName>
    <Version>0.1.0-beta.26</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Din Desk</Product>
    <Description>Local AI proxy for Claude Code, Codex and agy CLI</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../../packaging/DinDesk.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ServerBinary)" LogicalName="MuseDesk.server.exe" Condition="Exists('$(ServerBinary)')" />
    <EmbeddedResource Include="../../claude-muse.ps1" LogicalName="MuseDesk.claude-muse.ps1" />
    <EmbeddedResource Include="../../codex-muse.ps1" LogicalName="MuseDesk.codex-muse.ps1" />
    <EmbeddedResource Include="../../codex-model-catalog.json" LogicalName="MuseDesk.codex-model-catalog.json" />
    <EmbeddedResource Include="../../dindesk-connection.ps1" LogicalName="MuseDesk.dindesk-connection.ps1" />
    <EmbeddedResource Include="../../packaging/DinDesk.ico" LogicalName="MuseDesk.icon.ico" />
    <EmbeddedResource Include="agy-settings.template.json" LogicalName="MuseDesk.agy-settings.template.json" />
    <EmbeddedResource Include="agy-statusline.ps1" LogicalName="MuseDesk.agy-statusline.ps1" />
  </ItemGroup>
</Project>
